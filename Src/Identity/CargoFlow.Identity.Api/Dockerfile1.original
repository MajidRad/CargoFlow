# See https://aka.ms/customizecontainer to learn how to customize your debug container and how Visual Studio uses this Dockerfile to build your images for faster debugging.

# This stage is used when running from VS in fast mode (Default for Debug configuration)
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
EXPOSE 8081


# This stage is used to build the service project
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["Src/Identity/CargoFlow.Identity.Api/CargoFlow.Identity.Api.csproj", "Src/Identity/CargoFlow.Identity.Api/"]
COPY ["Identity/CargoFlow.Identity.Application/CargoFlow.Identity.Application.csproj", "Identity/CargoFlow.Identity.Application/"]
COPY ["Src/BuildingBlocks/CargoFlow.BuildingBlocks.Application/CargoFlow.BuildingBlocks.Application.csproj", "Src/BuildingBlocks/CargoFlow.BuildingBlocks.Application/"]
COPY ["Identity/CargoFlow.Identity.Domain/CargoFlow.Identity.Domain.csproj", "Identity/CargoFlow.Identity.Domain/"]
COPY ["Src/BuildingBlocks/CargoFlow.BuildingBlocks.Domain/CargoFlow.BuildingBlocks.Domain.csproj", "Src/BuildingBlocks/CargoFlow.BuildingBlocks.Domain/"]
COPY ["Identity/CargoFlow.Identity.Infrastructure/CargoFlow.Identity.Infrastructure.csproj", "Identity/CargoFlow.Identity.Infrastructure/"]
COPY ["Src/BuildingBlocks/CargoFlow.BuildingBlocks.Presentation/CargoFlow.BuildingBlocks.Presentation.csproj", "Src/BuildingBlocks/CargoFlow.BuildingBlocks.Presentation/"]
RUN dotnet restore "./Src/Identity/CargoFlow.Identity.Api/CargoFlow.Identity.Api.csproj"
COPY . .
WORKDIR "/src/Src/Identity/CargoFlow.Identity.Api"
RUN dotnet build "./CargoFlow.Identity.Api.csproj" -c $BUILD_CONFIGURATION -o /app/build

# This stage is used to publish the service project to be copied to the final stage
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./CargoFlow.Identity.Api.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# This stage is used in production or when running from VS in regular mode (Default when not using the Debug configuration)
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "CargoFlow.Identity.Api.dll"]